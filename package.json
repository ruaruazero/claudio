{
  "name": "claudio-agent-lab",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/main.ts",
    "test:agent": "tsx --test server/*.test.ts",
    "test:behavior": "tsx scripts/test-behavior.ts",
    "test:sequences": "tsx scripts/test-sequences.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "desktop:icon": "node scripts/create-icon.mjs",
    "desktop:prepare": "npm run build && npm run desktop:icon && node scripts/build-desktop.mjs",
    "desktop:mac": "npm run desktop:prepare && electron-builder --mac --arm64",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/deepseek": "1.1.19",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "better-sqlite3": "12.11.1",
    "dotenv": "^16.6.1",
    "eventsource-parser": "^3.0.6",
    "fastify": "^5.6.0",
    "langchain": "1.5.19",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "electron": "43.8.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "6.3.5"
  }
}
